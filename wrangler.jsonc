{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seeable-hoardings",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  // Runtime env vars / secrets are set in the Cloudflare dashboard or via
  // `wrangler secret put`. Never commit real values here.
  // NEXT_PUBLIC_* vars are inlined at build time from the build environment.
  "vars": {
    "NEXT_PUBLIC_ENV": "production",
  },
}
