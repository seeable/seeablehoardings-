# =============================================================================
# SEEABLE Hoardings — environment contract
# Copy to .env.local for local dev. Real values live in Cloudflare env +
# GitHub Actions secrets, NEVER in git (IMPLEMENTATION-PLAN.md §1 / §Phase 0).
# =============================================================================

# --- Client (safe for the browser — inlined at build time) --------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLISHABLE_KEY
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ENV=development
# Phase 6 — MapLibre style URL (MapTiler free tier, domain-restricted key)
NEXT_PUBLIC_MAP_STYLE_URL=

# --- Server only -------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_PROJECT_REF=YOUR_PROJECT_REF
SUPABASE_ACCESS_TOKEN=                 # CI migrations (supabase CLI)

# Request Engine (Phase 7) — SLA is config, not a constant (Decision D8)
REQUEST_SLA_HOURS=48
REQUEST_EXPIRING_SOON_HOURS=6

# Media (Phase 5)
MEDIA_MAX_UPLOAD_MB=10
MEDIA_MIN_PHOTOS_TO_SUBMIT=3

# Auth (Decision D2 — password login for the MVP; OTP is a drop-in future step)
AUTH_OTP_ENABLED=false
# Google OAuth (Viewer sign-in only). Set in the hosted Supabase dashboard;
# these two are only needed to run Supabase locally (`supabase start`).
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# Notifications email (Phase 10 — optional, best-effort)
RESEND_API_KEY=
EMAIL_FROM=

# Admin provisioning (Phase 9 — out-of-band, no public Admin signup)
ADMIN_BOOTSTRAP_EMAIL=

# --- GitHub Actions secrets (not used at runtime) ----------------------------
# CLOUDFLARE_API_TOKEN
# CLOUDFLARE_ACCOUNT_ID
# SUPABASE_ACCESS_TOKEN
# SUPABASE_PROJECT_REF
